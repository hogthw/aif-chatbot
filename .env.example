# ==============================================================================
# AIF-CHATBOT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép tệp này thành .env hoặc .dev.vars khi cấu hình môi trường cục bộ.
# LƯU Ý: Không commit tệp .env hoặc .dev.vars chứa secret thật lên git repository!
# ==============================================================================

# --- Chatbot Worker (workers/aif-kb-chat) ---
# Địa chỉ URL của Worker chatbot sau khi deploy
CHAT_URL=https://aif-kb-chat.your-subdomain.workers.dev

# Mã bảo vệ giao tiếp giữa Website widget và Worker (Wrangler secret: CHAT_SECRET)
CHAT_SECRET=your_chat_client_secret_here

# Mã quyền quản trị xem prompt nội bộ và tài liệu tra cứu qua /debug (Wrangler secret: ADMIN_TOKEN)
ADMIN_TOKEN=your_admin_debug_token_here

# Tên miền website được phép gọi API (CORS)
ORIGIN=https://aifirstbusiness.vn

# ID instance Cloudflare AI Search (Vectorize)
AI_SEARCH_INSTANCE=autumn-sky-17c5

# --- Knowledge Base Sync Worker (workers/aif-kb-sync) ---
# Mã xác thực để gọi API kích hoạt đồng bộ thủ công POST /sync hoặc GET /status
SYNC_TOKEN=your_sync_secret_token_here

# ID thư mục AIF-KB trên Google Drive (chuỗi ký tự phía sau /folders/...)
DRIVE_FOLDER_ID=1uN6PgLa9jDW6G1T4vjpRmCuIzhHtfYiz

# Khóa Service Account của Google Cloud (nội dung file JSON chứa client_email & private_key)
# Đặt trên Cloudflare bằng lệnh: npx wrangler secret put GOOGLE_SA_KEY
GOOGLE_SA_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}'

# --- Cloudflare Infrastructure ---
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
KV_NAMESPACE_ID=43f2b14db52e4e01a84e27c27e7f7499

